# Copy to observability/.env and fill in. Never commit .env; observability/.gitignore lists it.

# Grafana admin login. Choose a long random password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<grafana-admin-password>

# Interface the ports bind to. 127.0.0.1 keeps the stack on this machine.
BIND_ADDR=127.0.0.1

# Retention. Prometheus: metrics. Loki: logs (a multiple of 24h). Alertmanager: silences.
PROM_RETENTION=30d
LOKI_RETENTION=30d
AM_RETENTION=120h

# Viewers without a login get read-only access when true.
GRAFANA_ANONYMOUS=false
