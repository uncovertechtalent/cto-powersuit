# Claude Code telemetry to the observability stack (Alloy OTLP receiver).
# Source this file, or copy the keys into the "env" block of ~/.claude/settings.json or managed
# settings. Claude Code ignores these variables in a repository's .claude/settings.json.
# Check before use: variable names against the Claude Code monitoring documentation.
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://<stack-host>:4317
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
# Spend is summed from the per-request api_request events in Loki. Parallel agent
# processes write the same cumulative counter series, which then read as counter
# resets, so nothing sums the counters.
export OTEL_METRICS_INCLUDE_SESSION_ID=false
# Tool parameters in tool events: shell commands, file paths, skill names, and MCP server and
# tool names. A command that carries a secret is stored with it (see /ai-ops:tool-audit, step 2).
# Prompt and response text stay off (the default).
export OTEL_LOG_TOOL_DETAILS=1
